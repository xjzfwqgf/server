# 夜场视频站后端环境变量样例
# 复制为 server/.env 后按需填写。本地开发大部分可以留空。
#
# ⚠️ 千万不要把 COS_SECRET_KEY / TURSO_AUTH_TOKEN / JWT_SECRET 提交进 git。
# Vercel 部署时这些值填在项目的 Environment Variables 里，不要写进仓库。

# ========== 基础 ==========
# 本地端口/监听地址（Vercel 不使用，但保留给自建部署）
PORT=3000
HOST=127.0.0.1

# 生产必须显式设置；留空会自动生成随机密钥并写 server/.jwt-secret（Vercel 上写不了文件，会退化成每次冷启动随机，登录态全失效）
JWT_SECRET=

# 前后端分域部署时，这里必须包含前端的生产域名（逗号分隔）
# 例：CORS_ORIGINS=https://video-site.vercel.app,https://www.example.com
CORS_ORIGINS=
FRONTEND_URL=

# ========== 数据库（Turso / libSQL） ==========
# 本地开发不填：自动使用 file:server/data.db（node:sqlite）
# Vercel 部署必填：
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 可选：本地库文件路径覆盖
# DB_FILE=./data.db

# ========== 对象存储（腾讯云 COS，公有读 + CDN） ==========
# local = 本机服务器/uploads（仅本地开发）；cos = 线上
STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
# 公有读桶绑定的 CDN 域名，末尾不要带斜杠
COS_CDN_BASE=

# 桶内目录前缀（一般不用改）
COS_PREFIX_VIDEO=videos
COS_PREFIX_COVER=covers
COS_PREFIX_AVATAR=avatars
COS_PREFIX_MUSIC=music

# ========== 上传 ==========
# 单文件上限（MB）。默认 4096 = 4GB。
# 线上走 COS 直传，这个值只用于前端预检 + 本地 multipart；COS 单次 PUT 硬上限 5GB，别超过。
MAX_VIDEO_SIZE_MB=4096
# 本机路径导入白名单（仅本地磁盘模式；Windows 用分号分隔）
IMPORT_ALLOWED_DIRS=

# ========== 音乐（酷狗代理，可选） ==========
# 线上没有本地酷狗代理时留空：只播放已迁移到 COS 的曲目
KUGOU_API_BASE=http://127.0.0.1:3100
MUSIC_KUGOU_QUALITY=128

# ========== GitHub 第三方登录（可选） ==========
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 必须与 GitHub OAuth App 里登记的完全一致（Vercel 上是后端域名）
GITHUB_REDIRECT_URI=https://your-server.vercel.app/api/auth/github/callback
GITHUB_FRONTEND_URL=https://your-frontend.vercel.app

# ========== 夜场账号 OAuth Provider（可选） ==========
OAUTH_PROVIDER_CLIENT_ID=video-site-client
OAUTH_PROVIDER_CLIENT_SECRET=
OAUTH_PROVIDER_BASE_URL=
OAUTH_PROVIDER_REDIRECT_URI=https://your-server.vercel.app/api/auth/oauth/callback
OAUTH_PROVIDER_FRONTEND_URL=https://your-frontend.vercel.app

# ========== MC 认证服（Yggdrasil，可选） ==========
YGGDRASIL_MOUNT_PATH=/mc
YGGDRASIL_DEFAULT_SKIN=
YGGDRASIL_TOKEN_TTL=604800

# ========== HTTPS 直出（自建部署可选，Vercel 不用） ==========
# HTTPS_CERT=/path/fullchain.pem
# HTTPS_KEY=/path/privkey.pem
